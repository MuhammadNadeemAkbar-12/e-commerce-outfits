  margin-top: 0.2rem;
  color: #b7c5da;
  font-size: 0.85rem;
}

.newsletter-row {
  display: flex;
  gap: 0.5rem;
  margin-top: 0.8rem;
}

.newsletter-input {
  flex: 1;
}

